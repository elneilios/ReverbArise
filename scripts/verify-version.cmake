cmake_minimum_required(VERSION 3.22)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/ProductVersion.cmake")
if(NOT DEFINED SOURCE_DIR)
    get_filename_component(SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
reverbarise_product_version("${SOURCE_DIR}" version)
set(expected_tag "v${version}")
set(tag_verified false)
set(requested_tag "")
if(DEFINED RELEASE_TAG)
    if(NOT RELEASE_TAG STREQUAL expected_tag)
        message(FATAL_ERROR "Release tag '${RELEASE_TAG}' does not match CMake product version ${version}; expected exactly '${expected_tag}'")
    endif()
    set(requested_tag "${RELEASE_TAG}")
    set(tag_verified true)
endif()
set(candidate "")
set(release_identity "${expected_tag}")
if(DEFINED CANDIDATE)
    if(NOT CANDIDATE MATCHES "^[A-Za-z0-9]+([.-][A-Za-z0-9]+)*$")
        message(FATAL_ERROR "Invalid CANDIDATE label: use alphanumeric components separated by dots or hyphens, e.g. rc.1")
    endif()
    set(candidate "${CANDIDATE}")
    set(release_identity "${expected_tag}-${candidate}")
endif()
set(built_verified false)
if(DEFINED BINARY_DIR)
    if(NOT DEFINED CONFIGURATION OR NOT CONFIGURATION MATCHES "^(Debug|Release)$")
        message(FATAL_ERROR "Built verification requires CONFIGURATION=Debug or Release")
    endif()
    file(READ "${BINARY_DIR}/product-identity.json" identity)
    foreach(pair IN ITEMS "version|${version}" "manufacturerCode|K7Ma" "pluginCode|Prv1" "bundleId|com.k7ma.preverb" "productName|ReverbArise")
        string(REPLACE "|" ";" parts "${pair}")
        list(GET parts 0 key)
        list(GET parts 1 expected)
        string(JSON actual GET "${identity}" "${key}")
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Build identity mismatch for ${key}: '${actual}' expected '${expected}'; configure/rebuild this checkout")
        endif()
    endforeach()
    set(bundle "${BINARY_DIR}/preverb_plugin_artefacts/${CONFIGURATION}/VST3/ReverbArise.vst3")
    if(NOT EXISTS "${bundle}/Contents/x86_64-win/ReverbArise.vst3")
        message(FATAL_ERROR "Missing built VST3 binary: ${bundle}; build ${CONFIGURATION} first")
    endif()
    file(READ "${bundle}/Contents/Resources/moduleinfo.json" module)
    string(JSON module_version GET "${module}" Version)
    string(JSON module_name GET "${module}" Name)
    if(NOT module_version STREQUAL version OR NOT module_name STREQUAL "ReverbArise")
        message(FATAL_ERROR "Built VST3 name/version mismatch: '${module_name}' '${module_version}', expected ReverbArise ${version}")
    endif()
    string(JSON count LENGTH "${module}" Classes)
    if(NOT count EQUAL 2)
        message(FATAL_ERROR "Unexpected VST3 class count: ${count}")
    endif()
    set(expected_cids ABCDEF019182FAEB4B374D6150727631 ABCDEF011234ABCD4B374D6150727631)
    foreach(index RANGE 0 1)
        foreach(key IN ITEMS CID Version Vendor Name Category)
            string(JSON actual_${key} GET "${module}" Classes ${index} ${key})
        endforeach()
        if(NOT actual_Version STREQUAL version OR NOT actual_Vendor STREQUAL "K7MA" OR NOT actual_Name STREQUAL "ReverbArise")
            message(FATAL_ERROR "Built VST3 class version/vendor/name mismatch")
        endif()
        if(actual_Category STREQUAL "Audio Module Class")
            set(expected_cid ABCDEF019182FAEB4B374D6150727631)
        elseif(actual_Category STREQUAL "Component Controller Class")
            set(expected_cid ABCDEF011234ABCD4B374D6150727631)
        else()
            message(FATAL_ERROR "Unexpected VST3 class category: ${actual_Category}")
        endif()
        if(NOT actual_CID STREQUAL expected_cid OR NOT actual_CID IN_LIST expected_cids)
            message(FATAL_ERROR "VST3 stable class identity changed: ${actual_CID}")
        endif()
        list(REMOVE_ITEM expected_cids "${actual_CID}")
    endforeach()
    set(built_verified true)
elseif(DEFINED CONFIGURATION)
    message(FATAL_ERROR "CONFIGURATION requires BINARY_DIR")
endif()
set(result "{\n  \"version\": \"${version}\",\n  \"expectedTag\": \"${expected_tag}\",\n  \"requestedTag\": \"${requested_tag}\",\n  \"tagVerified\": ${tag_verified},\n  \"candidate\": \"${candidate}\",\n  \"releaseIdentity\": \"${release_identity}\",\n  \"builtVerified\": ${built_verified}\n}\n")
if(DEFINED OUTPUT_FILE)
    # Written only after every requested check succeeds. Never treat an old file as success.
    file(WRITE "${OUTPUT_FILE}" "${result}")
endif()
message(STATUS "Product version ${version}; identity ${release_identity}; tagVerified=${tag_verified}; builtVerified=${built_verified}")
