cmake_minimum_required(VERSION 3.22)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/ProductVersion.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/BuildInformation.cmake")
if(DEFINED BAD_CASE)
    set(PREVERB_RELEASE_TAG "v0.1.0")
    set(PREVERB_RELEASE_CANDIDATE "${BAD_CASE}")
    if(BAD_CASE STREQUAL "wrong-tag")
        set(PREVERB_RELEASE_TAG "v0.2.0")
        set(PREVERB_RELEASE_CANDIDATE "")
    elseif(BAD_CASE STREQUAL "no-tag")
        set(PREVERB_RELEASE_TAG "")
        set(PREVERB_RELEASE_CANDIDATE "alpha")
    endif()
    reverbarise_build_information("${TEST_ROOT}/repo" "${TEST_ROOT}/invalid" "0.1.0" "ReverbArise")
    return()
endif()
find_package(Git REQUIRED)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run)
set(TEST_ROOT "${TEST_ROOT}/${run}")
set(repo "${TEST_ROOT}/repo")
set(binary "${TEST_ROOT}/generated")
file(MAKE_DIRECTORY "${repo}")
file(WRITE "${repo}/source.txt" "fixture source\n")
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${repo}" init --quiet COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${repo}" add . COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${repo}" -c user.name=Fixture -c user.email=fixture@example.invalid commit -qm source COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${repo}" rev-parse HEAD OUTPUT_VARIABLE expected_sha OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
set(PREVERB_RELEASE_TAG "v0.1.0")
set(PREVERB_RELEASE_CANDIDATE "alpha.4")
reverbarise_build_information("${repo}" "${binary}" "0.1.0" "ReverbArise")
file(READ "${binary}/build-information.json" metadata)
foreach(pair IN ITEMS "version|0.1.0" "candidate|alpha.4" "buildIdentifier|v0.1.0-alpha.4" "gitSha|${expected_sha}" "worktreeDirty|OFF")
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 key)
    list(GET parts 1 expected)
    string(JSON actual GET "${metadata}" "${key}")
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Unexpected ${key}: ${actual}, expected ${expected}")
    endif()
endforeach()
file(SHA256 "${binary}/generated/BuildInformationData.h" header_hash)
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1)
reverbarise_build_information("${repo}" "${binary}" "0.1.0" "ReverbArise")
file(READ "${binary}/build-information.json" repeated)
file(SHA256 "${binary}/generated/BuildInformationData.h" repeated_hash)
if(NOT metadata STREQUAL repeated OR NOT header_hash STREQUAL repeated_hash)
    message(FATAL_ERROR "Unchanged identity generation is not deterministic")
endif()
set(PREVERB_RELEASE_TAG "")
set(PREVERB_RELEASE_CANDIDATE "")
file(APPEND "${repo}/source.txt" "changed\n")
reverbarise_build_information("${repo}" "${binary}" "0.1.0" "ReverbArise")
file(READ "${binary}/build-information.json" local)
string(JSON identifier GET "${local}" buildIdentifier)
string(JSON candidate GET "${local}" candidate)
string(JSON dirty GET "${local}" worktreeDirty)
if(NOT identifier STREQUAL "v0.1.0-local" OR NOT candidate STREQUAL "" OR NOT dirty)
    message(FATAL_ERROR "Local build retained a release identity or hid modified source")
endif()
foreach(invalid IN ITEMS "../escape" "alpha_4" "wrong-tag" "no-tag")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DTEST_ROOT=${TEST_ROOT}" "-DBAD_CASE=${invalid}" -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if(result EQUAL 0)
        message(FATAL_ERROR "Invalid build identity accepted: ${invalid}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${repo}/exported-source")
reverbarise_build_information("${repo}/exported-source" "${binary}" "0.1.0" "ReverbArise")
file(READ "${binary}/build-information.json" unavailable)
string(JSON unavailable_sha GET "${unavailable}" gitSha)
if(NOT unavailable_sha STREQUAL "unavailable")
    message(FATAL_ERROR "An exported source directory borrowed an unrelated parent Git identity")
endif()
message(STATUS "PASS build identity: version/SHA, candidate/local reset, dirty source, deterministic outputs, invalid inputs")
