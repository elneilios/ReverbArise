cmake_minimum_required(VERSION 3.22)
get_filename_component(source "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED TEST_ROOT)
    set(TEST_ROOT "${source}/out/version-contract-fixtures")
endif()
set(fixture "${TEST_ROOT}/source with spaces")
file(MAKE_DIRECTORY "${fixture}")
set(verifier "${source}/scripts/verify-version.cmake")
set(output "${TEST_ROOT}/result.json")
set(check_count 0)
function(check name expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${fixture}" ${ARGN} -P "${verifier}"
        RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(expected STREQUAL "pass")
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "${name}: expected success, got ${status}\n${stdout}\n${stderr}")
        endif()
    elseif(status EQUAL 0)
        message(FATAL_ERROR "${name}: unexpectedly succeeded")
    endif()
    math(EXPR count "${check_count}+1")
    set(check_count ${count} PARENT_SCOPE)
endfunction()
function(set_version version)
    file(WRITE "${fixture}/CMakeLists.txt" "# project(NotTheAuthority VERSION 99.0.0)\nproject(Preverb VERSION ${version} LANGUAGES C CXX)\n")
endfunction()
set_version(0.1.0)
check(source_read pass "-DOUTPUT_FILE=${output}")
file(READ "${output}" metadata)
string(JSON verified GET "${metadata}" tagVerified)
if(verified)
    message(FATAL_ERROR "A source-only read must not claim a verified tag")
endif()
check(matching_tag pass -DRELEASE_TAG=v0.1.0)
check(candidate pass -DRELEASE_TAG=v0.1.0 -DCANDIDATE=rc.1 "-DOUTPUT_FILE=${output}")
file(READ "${output}" metadata)
string(JSON identity GET "${metadata}" releaseIdentity)
string(JSON numeric GET "${metadata}" version)
if(NOT identity STREQUAL "v0.1.0-rc.1" OR NOT numeric STREQUAL "0.1.0")
    message(FATAL_ERROR "Candidate label changed numeric identity")
endif()
file(SHA256 "${output}" before_failure)
check(failed_tag_does_not_write_metadata fail -DRELEASE_TAG=v9.9.9 "-DOUTPUT_FILE=${output}")
file(SHA256 "${output}" after_failure)
if(NOT before_failure STREQUAL after_failure)
    message(FATAL_ERROR "Failed verification overwrote successful output")
endif()
set_version(255.255.255)
check(maximum_supported_version pass -DRELEASE_TAG=v255.255.255)
set_version(0.1.0)
foreach(tag IN ITEMS v0.2.0 0.1.0 v01.1.0 v0.1.0-rc.1 "")
    check("bad_tag_${tag}" fail "-DRELEASE_TAG=${tag}")
endforeach()
foreach(label IN ITEMS "" ../bad "rc 1" "rc+1" "rc..1")
    check("bad_label_${label}" fail "-DCANDIDATE=${label}")
endforeach()
set_version(0.2.3)
check(manual_bump pass -DRELEASE_TAG=v0.2.3 "-DOUTPUT_FILE=${output}")
file(READ "${output}" metadata)
string(JSON numeric GET "${metadata}" version)
if(NOT numeric STREQUAL "0.2.3")
    message(FATAL_ERROR "Source edit did not propagate")
endif()
foreach(version IN ITEMS 00.1.0 0.01.0 0.1.00 0.1 0.1.0.1 0.1.0-rc.1 0.256.0 256.0.0 0.0.999999999999999)
    set_version("${version}")
    check("bad_version_${version}" fail)
endforeach()
set_version(0.1.0)
file(APPEND "${fixture}/CMakeLists.txt" "project(Preverb VERSION 9.9.9 LANGUAGES C CXX)\n")
check(duplicate_declaration fail)
set_version(0.1.0)
set(binary "${TEST_ROOT}/build with spaces")
set(bundle "${binary}/preverb_plugin_artefacts/Release/VST3/ReverbArise.vst3/Contents")
file(MAKE_DIRECTORY "${bundle}/Resources" "${bundle}/x86_64-win")
# Deliberately not a real DLL: these exercise metadata checks, not native builds.
file(WRITE "${bundle}/x86_64-win/ReverbArise.vst3" "fixture")
set(identity_json "{\"version\":\"0.1.0\",\"manufacturerCode\":\"K7Ma\",\"pluginCode\":\"Prv1\",\"bundleId\":\"com.k7ma.preverb\",\"productName\":\"ReverbArise\"}")
file(WRITE "${binary}/product-identity.json" "${identity_json}")
set(module_json [=[{"Name":"ReverbArise","Version":"0.1.0","Classes":[{"CID":"ABCDEF019182FAEB4B374D6150727631","Category":"Audio Module Class","Name":"ReverbArise","Version":"0.1.0","Vendor":"K7MA",},{"CID":"ABCDEF011234ABCD4B374D6150727631","Category":"Component Controller Class","Name":"ReverbArise","Version":"0.1.0","Vendor":"K7MA",},],}]=])
file(WRITE "${bundle}/Resources/moduleinfo.json" "${module_json}")
check(built_metadata pass "-DBINARY_DIR=${binary}" -DCONFIGURATION=Release)
set_version(0.2.0)
check(stale_build fail "-DBINARY_DIR=${binary}" -DCONFIGURATION=Release)
set_version(0.1.0)
foreach(replacement IN ITEMS "0.2.0" "wrong-cid")
    if(replacement STREQUAL "wrong-cid")
        string(REPLACE "ABCDEF019182FAEB4B374D6150727631" "00000000000000000000000000000000" broken "${module_json}")
    else()
        string(REPLACE "0.1.0" "0.2.0" broken "${module_json}")
    endif()
    file(WRITE "${bundle}/Resources/moduleinfo.json" "${broken}")
    check("broken_module_${replacement}" fail "-DBINARY_DIR=${binary}" -DCONFIGURATION=Release)
endforeach()
# A class-only drift must fail even when the module-level version matches.
string(REPLACE "\"Version\":\"0.1.0\",\"Vendor\"" "\"Version\":\"0.2.0\",\"Vendor\"" broken "${module_json}")
file(WRITE "${bundle}/Resources/moduleinfo.json" "${broken}")
check(class_version_drift fail "-DBINARY_DIR=${binary}" -DCONFIGURATION=Release)
file(WRITE "${bundle}/Resources/moduleinfo.json" "${module_json}")
string(REPLACE "com.k7ma.preverb" "com.changed.identity" broken "${identity_json}")
file(WRITE "${binary}/product-identity.json" "${broken}")
check(changed_bundle_id fail "-DBINARY_DIR=${binary}" -DCONFIGURATION=Release)
file(WRITE "${binary}/product-identity.json" "${identity_json}")
file(RENAME "${bundle}/Resources/moduleinfo.json" "${bundle}/Resources/moduleinfo.hidden")
check(missing_metadata fail "-DBINARY_DIR=${binary}" -DCONFIGURATION=Release)
file(RENAME "${bundle}/Resources/moduleinfo.hidden" "${bundle}/Resources/moduleinfo.json")
file(RENAME "${bundle}/x86_64-win/ReverbArise.vst3" "${bundle}/x86_64-win/ReverbArise.hidden")
check(missing_binary fail "-DBINARY_DIR=${binary}" -DCONFIGURATION=Release)
file(RENAME "${bundle}/x86_64-win/ReverbArise.hidden" "${bundle}/x86_64-win/ReverbArise.vst3")
check(invalid_configuration fail "-DBINARY_DIR=${binary}" -DCONFIGURATION=Other)
check(configuration_without_build fail -DCONFIGURATION=Release)
message(STATUS "PASS: ${check_count} compiler-free version contract cases; built metadata cases are fixtures, not native validation")
