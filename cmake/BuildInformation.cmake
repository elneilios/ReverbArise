# Shared configure-time identity. No wall clock, random ID or workspace path.
function(reverbarise_build_information source_dir binary_dir version product_name)
    set(release_tag "${PREVERB_RELEASE_TAG}")
    set(candidate "${PREVERB_RELEASE_CANDIDATE}")
    if(release_tag AND NOT release_tag STREQUAL "v${version}")
        message(FATAL_ERROR "Release tag '${release_tag}' does not match CMake product version ${version}")
    endif()
    if(candidate)
        reverbarise_validate_candidate("${candidate}")
    endif()
    if(candidate AND NOT release_tag)
        message(FATAL_ERROR "A release candidate requires an explicit matching release tag")
    endif()
    if(release_tag)
        set(build_identifier "${release_tag}")
        if(candidate)
            string(APPEND build_identifier "-${candidate}")
        endif()
    else()
        set(build_identifier "v${version}-local")
    endif()
    set(git_sha "unavailable")
    set(worktree_dirty false)
    find_package(Git QUIET)
    if(Git_FOUND)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source_dir}" rev-parse --show-toplevel
            RESULT_VARIABLE root_result OUTPUT_VARIABLE git_root OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        get_filename_component(expected_root "${source_dir}" REALPATH)
        get_filename_component(git_root "${git_root}" REALPATH)
        if(WIN32)
            string(TOLOWER "${expected_root}" expected_root)
            string(TOLOWER "${git_root}" git_root)
        endif()
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source_dir}" rev-parse --verify "HEAD^{commit}"
            RESULT_VARIABLE git_result OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        string(LENGTH "${revision}" revision_length)
        if(root_result EQUAL 0 AND git_root STREQUAL expected_root AND git_result EQUAL 0 AND revision_length EQUAL 40 AND revision MATCHES "^[a-f0-9]+$")
            set(git_sha "${revision}")
            execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source_dir}" status --porcelain=v1 --untracked-files=normal
                RESULT_VARIABLE status_result OUTPUT_VARIABLE status OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
            if(NOT status_result EQUAL 0 OR NOT status STREQUAL "")
                set(worktree_dirty true)
            endif()
        endif()
    endif()
    file(MAKE_DIRECTORY "${binary_dir}/generated")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/BuildInformationData.h.in" "${binary_dir}/generated/BuildInformationData.h" @ONLY)
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/build-information.json.in" "${binary_dir}/build-information.json" @ONLY)
endfunction()
