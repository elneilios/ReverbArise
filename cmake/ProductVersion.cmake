# Read only the literal root project declaration; never configure or fetch dependencies.
function(reverbarise_validate_candidate candidate)
    if(NOT candidate MATCHES "^[A-Za-z0-9]+([.-][A-Za-z0-9]+)*$")
        message(FATAL_ERROR "Invalid CANDIDATE label: use alphanumeric components separated by dots or hyphens, e.g. rc.1")
    endif()
endfunction()

function(reverbarise_product_version source_dir output)
    file(STRINGS "${source_dir}/CMakeLists.txt" declarations REGEX "^[ \t]*project[ \t]*\\(")
    list(LENGTH declarations count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Expected one literal root project(Preverb VERSION X.Y.Z ...) declaration")
    endif()
    list(GET declarations 0 declaration)
    if(NOT declaration MATCHES "^[ \t]*project[ \t]*\\(Preverb[ \t]+VERSION[ \t]+([^ \t)]+)[ \t]+LANGUAGES[ \t]+C[ \t]+CXX[ \t]*\\)[ \t]*(#.*)?$")
        message(FATAL_ERROR "Use a literal project(Preverb VERSION X.Y.Z LANGUAGES C CXX) declaration")
    endif()
    set(version "${CMAKE_MATCH_1}")
    if(NOT version MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
        message(FATAL_ERROR "Invalid product version '${version}': require X.Y.Z without leading zeroes or suffixes")
    endif()
    foreach(component IN ITEMS "${CMAKE_MATCH_1}" "${CMAKE_MATCH_2}" "${CMAKE_MATCH_3}")
        string(LENGTH "${component}" digits)
        if(digits GREATER 3 OR component GREATER 255)
            message(FATAL_ERROR "Product version components must be 0..255 for JUCE numeric encoding")
        endif()
    endforeach()
    set(${output} "${version}" PARENT_SCOPE)
endfunction()
