# Diagnostic-only task 1.4. Never patch shared FetchContent sources.
if(PREVERB_RELEASE_TAG OR PREVERB_RELEASE_CANDIDATE)
    message(FATAL_ERROR "Disable PREVERB_PROJECT_FOLDER_PROBE before tagged/candidate builds")
endif()
if(NOT WIN32)
    message(FATAL_ERROR "Project-folder probe requires the inspected Windows JUCE 9.0.4 wrapper")
endif()
set(probe_wrapper "${JUCE_SOURCE_DIR}/modules/juce_audio_plugin_client/juce_audio_plugin_client_VST3.cpp")
file(SHA256 "${probe_wrapper}" probe_sha256)
if(NOT probe_sha256 STREQUAL "e62c50f3e6fb6c93e2cd3934e40eac506d0affb4bbe63783e0aa7be414ebd47a")
    message(FATAL_ERROR "Inspected JUCE 9.0.4 wrapper hash changed; re-review probe boundaries")
endif()
file(READ "${probe_wrapper}" probe_source)
foreach(method IN ITEMS setState getState)
    set(needle "    tresult PLUGIN_API ${method} (IBStream* state) override\n    {")
    string(REGEX MATCHALL "tresult PLUGIN_API ${method} \\(IBStream\\* state\\) override" matches "${probe_source}")
    list(LENGTH matches count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Probe wrapper boundary changed: ${method}")
    endif()
    string(FIND "${probe_source}" "${needle}" position)
    if(position LESS 0)
        message(FATAL_ERROR "Probe wrapper layout changed: ${method}")
    endif()
    string(REPLACE "${needle}" "${needle}\n        issue8::probe::observe(\"${method}\", state);" probe_source "${probe_source}")
endforeach()
string(REPLACE "#include <juce_audio_plugin_client/VST3/juce_VST3ModuleInfo.h>"
    "#include <juce_audio_plugin_client/VST3/juce_VST3ModuleInfo.h>\n#include \"ProjectFolderProbe.h\"" probe_source "${probe_source}")
set(probe_generated "${CMAKE_CURRENT_BINARY_DIR}/generated/issue8-folder-probe.cpp")
file(WRITE "${probe_generated}" "${probe_source}")
add_library(issue8_probe_wrapper INTERFACE)
foreach(property IN ITEMS INTERFACE_COMPILE_DEFINITIONS INTERFACE_COMPILE_FEATURES INTERFACE_INCLUDE_DIRECTORIES INTERFACE_LINK_LIBRARIES INTERFACE_COMPILE_OPTIONS)
    get_target_property(value juce_audio_plugin_client_VST3 ${property})
    if(value)
        set_property(TARGET issue8_probe_wrapper PROPERTY ${property} "${value}")
    endif()
endforeach()
get_target_property(wrapper_sources juce_audio_plugin_client_VST3 INTERFACE_SOURCES)
list(REMOVE_ITEM wrapper_sources "${probe_wrapper}")
target_sources(issue8_probe_wrapper INTERFACE ${wrapper_sources} "${probe_generated}")
target_include_directories(issue8_probe_wrapper INTERFACE "${CMAKE_CURRENT_SOURCE_DIR}/tests/diagnostics")
get_target_property(wrapper_links preverb_plugin_VST3 LINK_LIBRARIES)
list(REMOVE_ITEM wrapper_links juce::juce_audio_plugin_client_VST3)
set_property(TARGET preverb_plugin_VST3 PROPERTY LINK_LIBRARIES "${wrapper_links};issue8_probe_wrapper")
